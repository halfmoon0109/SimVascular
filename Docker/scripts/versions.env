# =============================================================================
# External versions -- single source of truth for the Docker build scripts.
#
# These values mirror the ACTIVE (2024.05) block of
#   Code/CMake/SimVascularExternalsVersions.cmake  (lines 84-116)
# which is what Code/CMake/SimVascularOptions.cmake registers for the build.
# Do not change them independently of that file.
# =============================================================================

QT_VERSION=6.6.2            # SimVascularExternalsVersions.cmake:86
HDF5_VERSION=1.14.3         # :87
TINYXML2_VERSION=8.0.0      # :90
PYTHON_VERSION=3.11.0       # :97  (any 3.11.x keeps include dir python3.11)
FREETYPE_VERSION=2.13.0     # :103
MMG_VERSION=5.3.9           # :105
GDCM_VERSION=3.0.10         # :106
VTK_VERSION=9.3.0           # :108
ITK_VERSION=5.4.0           # :111
OCC_VERSION=7.6.0           # :114

# MITK: the version string in SimVascularExternalsVersions.cmake:115 is a stale
# "2022.10", but this tree was ported to Qt6 (Code/CMake/Externals/Qt6.cmake
# components incl. Core5Compat) and carries "Fix code to use new MITK API"
# (862a1e8). The first upstream MITK with Qt6 is v2024.06 -- verified against
# its CMakeLists.txt (MITK_USE_Qt5 ON in <=v2023.12, MITK_USE_Qt6 ON in
# v2024.06). v2024.06 also pins exactly our other externals:
#   MITK_QT6_MINIMUM_VERSION 6.6  (our Qt 6.6.2)
#   CMakeExternals/VTK.cmake -> v9.3.0  (our VTK 9.3.0)
#   CMakeExternals/ITK.cmake -> v5.4.0  (our ITK 5.4.0)
# so the 2024.05 external set was clearly designed around MITK v2024.06.
# If sv4gui fails to compile against this MITK API, STOP and report -- do not
# silently change this (next candidates: v2024.06.2, then v2024.12).
MITK_GIT_TAG=v2024.06

# ---- Layout (matches what run-cmake.sh expects) -----------------------------
WORK=${WORK:-/work}
SRC_DIR=${SRC_DIR:-$WORK/externals/src}
BLD_DIR=${BLD_DIR:-$WORK/externals/build}
SV_EXTERNALS=${SV_EXTERNALS:-$WORK/externals}
INSTALL_DIR=$SV_EXTERNALS/install

NPROC=${NPROC:-$(nproc)}
